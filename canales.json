fetch('canales.json')
  .response => response.json()
  .then(data => {
    const contenedor = document.getElementById('lista-canales');
    
    data.canales.forEach(canal => {
      // Si el canal tiene ID, usamos un servicio directo para obtener su foto de perfil de YouTube
      // Si no tiene ID (como Superlibro), podemos poner una imagen por defecto.
      let imagenUrl = canal.id 
        ? `https://unavatar.io/youtube/${canal.id}` 
        : 'ruta/a/imagen-por-defecto.png';

      // Creamos la tarjeta del canal en tu HTML
      const tarjeta = `
        <div class="canal-card">
          <img src="${imagenUrl}" alt="${canal.nombre}" onerror="this.src='default.png'">
          <h3>${canal.nombre}</h3>
          <a href="${canal.url}" target="_blank">Ver Canal</a>
        </div>
      `;
      contenedor.innerHTML += tarjeta;
    });
  });
